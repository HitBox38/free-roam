# Copy to apps/web/.env.local. Local-only auth database; use persistent libSQL in production.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=local-dev-token
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional: same-origin authentication is the default.
# NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Transitional integration until the Python backend replaces SpacetimeDB.
NEXT_PUBLIC_SPACETIME_SERVER_URL=https://maincloud.spacetimedb.com
NEXT_PUBLIC_SPACETIME_DATABASE_NAME=free-roam-97kss
SPACETIME_SERVER_URL=https://maincloud.spacetimedb.com
SPACETIME_DATABASE_NAME=free-roam-97kss

# Optional, server-only location search key.
GEOAPIFY_API_KEY=
